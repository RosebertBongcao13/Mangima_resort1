-- =====================================================
-- SQL JOIN INTEGRATION EXAMPLES
-- =====================================================

-- =====================================================
-- INNER JOIN
-- Displays users with matching reservations only
-- Purpose:
-- To show reservation records together with user details
-- =====================================================


-- =====================================================
-- LEFT JOIN
-- Displays all users even if they have no reservations
-- Purpose:
-- To identify users without bookings
-- =====================================================


-- =====================================================
-- RIGHT JOIN
-- Displays all reservations even if user data is missing
-- Purpose:
-- To ensure all reservation records are displayed
-- =====================================================


-- =====================================================
-- FULL OUTER JOIN SIMULATION
-- MySQL does not directly support FULL OUTER JOIN
-- This is simulated using LEFT JOIN + RIGHT JOIN + UNION
-- Purpose:
-- To display all users and reservations whether matched or not
-- =====================================================